{
  "name": "close-combat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run sprites:prepare",
    "dev": "vite",
    "prebuild": "npm run sprites:prepare",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:visual": "python3 scripts/verify-shoto-visual.py",
    "measure:sprites": "python3 scripts/measure-sprites.py",
    "guides:sprites": "python3 scripts/measure-sprites.py && vite-node scripts/export-sprite-layout.ts && python3 scripts/render-sprite-guides.py",
    "calibrate:sprites": "python3 scripts/measure-sprites.py && vite-node scripts/calibrate-sprites.ts",
    "sprites:prepare": "python3 scripts/prepare-sprites.py",
    "sprites:apply-scales": "vite-node scripts/apply-sprite-scales.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "~5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
